{
  "schema_version": 1,
  "purpose": "Public source, synthetic tests, reusable templates and dependency manifests only.",
  "paths": [
    ".gitignore",
    "README.md",
    "creator_browser.py",
    "p2cos_quality.py",
    "p2cos_recovery.py",
    "p2cos_runs.py",
    "p2cos_state.py",
    "pixiv_pipeline.py",
    "public-export.json",
    "recovery_test_fixtures.py",
    "requirements-test.txt",
    "requirements.txt",
    "run_quality_validation.py",
    "social_auto_upload.requirements.lock",
    "social_auto_upload_adapter.py",
    "templates/BROWSER.txt",
    "templates/QUALITY_TASKS.txt",
    "templates/RECOVERY.md",
    "templates/RUNBOOK.txt",
    "templates/SOCIAL_AUTO_UPLOAD.md",
    "templates/generation_prompt.txt",
    "templates/prepare_task.txt",
    "templates/publish_task.txt",
    "test_p2cos_recovery.py",
    "test_p2cos_runs.py",
    "test_p2cos_selection.py",
    "test_p2cos_state.py",
    "test_pixiv_pipeline.py",
    "test_run_quality_validation.py",
    "test_social_auto_upload_adapter.py",
    "workflow.example.json"
  ],
  "excludes": [
    "credentials and environment files",
    "browser profile",
    "private runtime configuration and root operational documents",
    "production databases, history, reports, real prompts and receipts",
    "images and archives",
    "working outputs, caches, virtual environments and vendored upstream source"
  ],
  "authorization_boundary": "A Git push does not deploy or update cloud automations."
}
