# Public source repository: only explicitly reviewed paths are eligible.
/*
!/.gitignore
!/README.md
!/workflow.example.json
!/requirements.txt
!/requirements-test.txt
!/social_auto_upload.requirements.lock
!/public-export.json
!/p2cos_state.py
!/p2cos_quality.py
!/p2cos_runs.py
!/p2cos_recovery.py
!/p2cos_watchdog.py
!/pixiv_pipeline.py
!/creator_browser.py
!/social_auto_upload_adapter.py
!/run_quality_validation.py
!/recovery_test_fixtures.py
!/test_p2cos_state.py
!/test_p2cos_runs.py
!/test_p2cos_selection.py
!/test_p2cos_recovery.py
!/test_p2cos_watchdog.py
!/test_p2cos_unknown_replacement.py
!/test_pixiv_pipeline.py
!/test_social_auto_upload_adapter.py
!/test_run_quality_validation.py
!/templates/
/templates/*
!/templates/*.md
!/templates/*.txt
!/templates/*.json

# Private runtime configuration and operational instructions.
/workflow.json
/prepare_task.txt
/publish_task.txt
/recovery_task.txt
/recovery_policy.json
/recovery_authorization.json
/generation_prompt.txt
/QUALITY_TASKS.txt
/RUNBOOK.txt
/RECOVERY.md
/BROWSER.txt
/SOCIAL_AUTO_UPLOAD.md
/social_auto_upload.install.json

# Credentials, browser sessions, and local state (never force-add these).
**/browser-profile/
**/.env
**/.env.*
**/*cookie*
**/*credential*
**/*secret*
**/state.sqlite3*
**/*.sqlite
**/*.sqlite3
**/*.sqlite3-wal
**/*.sqlite3-shm
**/*.db
**/*.db-wal
**/*.db-shm
**/*.pem
**/*.key

# Media, archives, evidence, logs, generated prompts and local dependencies.
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.gif
**/*.avif
**/*.mp4
**/*.zip
**/*.tar
**/*.gz
**/*.log
**/work/
**/output/
**/cache/
**/.cache/
**/.pytest_cache/
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/venvs/
**/vendor/
**/social-auto-upload/
**/node_modules/
